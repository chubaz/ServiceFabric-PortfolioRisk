{
  "additionalProperties": false,
  "properties": {
    "available_at_field": {
      "anyOf": [
        {
          "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,127}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Available At Field"
    },
    "disclosure": {
      "minLength": 1,
      "title": "Disclosure",
      "type": "string"
    },
    "missing_available_at": {
      "default": "exclude",
      "enum": [
        "exclude",
        "retain_with_warning"
      ],
      "title": "Missing Available At",
      "type": "string"
    },
    "mode": {
      "enum": [
        "next_distinct_market_observation",
        "explicit_publication_field",
        "not_applicable"
      ],
      "title": "Mode",
      "type": "string"
    },
    "observed_at_field": {
      "anyOf": [
        {
          "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,127}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Observed At Field"
    },
    "policy_id": {
      "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,127}$",
      "title": "Policy Id",
      "type": "string"
    },
    "research_timing_model": {
      "const": true,
      "default": true,
      "title": "Research Timing Model",
      "type": "boolean"
    },
    "review_time": {
      "anyOf": [
        {
          "format": "time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Review Time"
    },
    "terminal_rule": {
      "default": "unavailable",
      "enum": [
        "unavailable",
        "explicit_reviewed_timestamp"
      ],
      "title": "Terminal Rule",
      "type": "string"
    },
    "version": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
      "title": "Version",
      "type": "string"
    }
  },
  "required": [
    "policy_id",
    "version",
    "mode",
    "disclosure"
  ],
  "title": "AvailabilityPolicy",
  "type": "object"
}
