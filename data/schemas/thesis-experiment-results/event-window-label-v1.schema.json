{
  "$defs": {
    "PortfolioDayKey": {
      "additionalProperties": false,
      "properties": {
        "as_of": {
          "format": "date-time",
          "title": "As Of",
          "type": "string"
        },
        "key_digest": {
          "default": "",
          "title": "Key Digest",
          "type": "string"
        },
        "portfolio_id": {
          "minLength": 1,
          "title": "Portfolio Id",
          "type": "string"
        },
        "window_id": {
          "enum": [
            "stress_a",
            "stress_b",
            "control"
          ],
          "title": "Window Id",
          "type": "string"
        }
      },
      "required": [
        "portfolio_id",
        "window_id",
        "as_of"
      ],
      "title": "PortfolioDayKey",
      "type": "object"
    }
  },
  "$id": "https://servicefabric.local/schemas/thesis-experiment-results/event-window-label-v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "evidence_refs": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Evidence Refs",
      "type": "array"
    },
    "key": {
      "$ref": "#/$defs/PortfolioDayKey"
    },
    "positive": {
      "title": "Positive",
      "type": "boolean"
    },
    "rationale": {
      "minLength": 1,
      "title": "Rationale",
      "type": "string"
    },
    "trigger_available_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Trigger Available At"
    }
  },
  "required": [
    "key",
    "positive",
    "rationale"
  ],
  "title": "EventWindowLabel",
  "type": "object"
}
