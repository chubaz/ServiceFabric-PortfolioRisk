{
  "$defs": {
    "SignalDirection": {
      "enum": [
        "downside",
        "upside"
      ],
      "title": "SignalDirection",
      "type": "string"
    },
    "SignalScope": {
      "enum": [
        "instrument",
        "group"
      ],
      "title": "SignalScope",
      "type": "string"
    }
  },
  "$id": "https://schemas.servicefabric.ai/risk/analytics/v0.1/anomaly-signal.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Sparse, versioned output from one detector threshold crossing.",
  "properties": {
    "available_at": {
      "format": "date-time",
      "title": "Available At",
      "type": "string"
    },
    "detector_definition_digest": {
      "pattern": "^sha256:[a-f0-9]{64}$",
      "title": "Detector Definition Digest",
      "type": "string"
    },
    "detector_id": {
      "maxLength": 256,
      "minLength": 1,
      "title": "Detector Id",
      "type": "string"
    },
    "detector_version": {
      "maxLength": 256,
      "minLength": 1,
      "title": "Detector Version",
      "type": "string"
    },
    "direction": {
      "$ref": "#/$defs/SignalDirection"
    },
    "evidence_ids": {
      "items": {
        "maxLength": 256,
        "minLength": 1,
        "type": "string"
      },
      "minItems": 1,
      "title": "Evidence Ids",
      "type": "array"
    },
    "forecast_horizon_sessions": {
      "minimum": 1,
      "title": "Forecast Horizon Sessions",
      "type": "integer"
    },
    "interval_end": {
      "format": "date-time",
      "title": "Interval End",
      "type": "string"
    },
    "interval_start": {
      "format": "date-time",
      "title": "Interval Start",
      "type": "string"
    },
    "lookback": {
      "minimum": 5,
      "title": "Lookback",
      "type": "integer"
    },
    "observation_time": {
      "format": "date-time",
      "title": "Observation Time",
      "type": "string"
    },
    "peak_time": {
      "format": "date-time",
      "title": "Peak Time",
      "type": "string"
    },
    "quality_flags": {
      "default": [],
      "items": {
        "maxLength": 256,
        "minLength": 1,
        "type": "string"
      },
      "title": "Quality Flags",
      "type": "array"
    },
    "raw_score": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
          "type": "string"
        }
      ],
      "title": "Raw Score"
    },
    "regime_id": {
      "maxLength": 256,
      "minLength": 1,
      "title": "Regime Id",
      "type": "string"
    },
    "scope_id": {
      "maxLength": 256,
      "minLength": 1,
      "title": "Scope Id",
      "type": "string"
    },
    "scope_type": {
      "$ref": "#/$defs/SignalScope"
    },
    "series_id": {
      "maxLength": 256,
      "minLength": 1,
      "title": "Series Id",
      "type": "string"
    },
    "signal_id": {
      "maxLength": 256,
      "minLength": 1,
      "title": "Signal Id",
      "type": "string"
    },
    "standardised_score": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
          "type": "string"
        }
      ],
      "title": "Standardised Score"
    },
    "status": {
      "const": "confirmed",
      "default": "confirmed",
      "title": "Status",
      "type": "string"
    },
    "threshold": {
      "anyOf": [
        {
          "exclusiveMinimum": 0.0,
          "type": "number"
        },
        {
          "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
          "type": "string"
        }
      ],
      "title": "Threshold"
    }
  },
  "required": [
    "signal_id",
    "series_id",
    "scope_type",
    "scope_id",
    "observation_time",
    "available_at",
    "detector_id",
    "detector_version",
    "detector_definition_digest",
    "lookback",
    "forecast_horizon_sessions",
    "direction",
    "raw_score",
    "standardised_score",
    "threshold",
    "regime_id",
    "interval_start",
    "interval_end",
    "peak_time",
    "evidence_ids"
  ],
  "title": "AnomalySignal",
  "type": "object"
}
